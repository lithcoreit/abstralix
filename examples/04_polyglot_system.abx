// Example 4: Polyglot Architecture
// Demonstrates: mixing Python code, JSON static configs, and auto-generated Markdown docs.

folder multi_cloud_app {
    @max_try = 3

    // 1. Static Configuration file
    file config.json {
        @inside = """{
  "service": "telemetry_collector",
  "port": 9090,
  "rate_limit": 1000,
  "debug": false
}"""
    }

    // 2. Python Backend Logic
    folder src {
        @lang = "python"

        file health.py {
            @info = "System health and status reporting"

            void get_system_status {
                @info = "Returns system health payload dict"
                @in = { uptime_seconds = "int" }
                @out = { status = "dict" }
                @context = "Return {'status': 'OK', 'uptime': uptime_seconds, 'healthy': True}."
                @invariant = """
                res = input(uptime_seconds=3600)
                if res != {'status': 'OK', 'uptime': 3600, 'healthy': True}:
                    incomplete(f"Unexpected status: {res}")
                complete()
                """
            }
        }
    }

    // 3. Documentation Generated by LLM
    folder docs {
        @lang = "markdown"

        file API_SPEC.md {
            void generate_api_doc {
                @context = """
                Write clean Markdown API documentation for a telemetry collector service:
                - Overview of GET /health
                - Expected JSON response
                - Error codes
                """
            }
        }
    }
}
