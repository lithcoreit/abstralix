folder fin_engine {
    @lang = "python"
    @lib = ["math"]
    @max_try = 4
    @max_session = 2

    folder parsers {
        file log_parser.py {
            @info = "Transaction log parsing and validation module"

            void parse_transaction_line {
                @info = "Parses 'YYYY-MM-DD | KIND | AMOUNT | CATEGORY' into a dict {'date': str, 'kind': str, 'amount': float, 'category': str}"
                @in = { line = "str" }
                @out = { record = "dict" }
                @context = """
                Parse a single transaction string formatted as:
                'YYYY-MM-DD | KIND | AMOUNT | CATEGORY'
                Rules:
                1. Split by '|' and strip whitespace from each part. If there are not exactly 4 parts, raise ValueError('Invalid format').
                2. date: must be a 10-character string where date[4] == '-' and date[7] == '-', otherwise raise ValueError('Invalid date').
                3. kind: convert to uppercase. Must be either 'INCOME' or 'EXPENSE', otherwise raise ValueError('Invalid kind').
                4. amount: convert to float and round to 2 decimal places. Must be strictly > 0, otherwise raise ValueError('Amount must be positive').
                5. category: must be non-empty string, otherwise raise ValueError('Empty category').
                Return dict: {'date': date, 'kind': kind, 'amount': amount, 'category': category}.
                """
                @invariant = """
                r = input(line=" 2026-11-01 | income | 1500.5 | Salary ")
                if r != {'date': '2026-11-01', 'kind': 'INCOME', 'amount': 1500.5, 'category': 'Salary'}:
                    incomplete(f"Unexpected parsed dict: {r}")
                try:
                    input(line="2026-11-01 | INVALID | 100 | Test")
                    incomplete("Should have raised ValueError for INVALID kind")
                except ValueError:
                    pass
                try:
                    input(line="2026-11-01 | EXPENSE | -50 | Food")
                    incomplete("Should have raised ValueError for negative amount")
                except ValueError:
                    pass
                complete()
                """
            }

            void parse_log_batch {
                @use = ["parse_transaction_line"]
                @info = "Parses multi-line raw text into {'records': list[dict], 'errors': list[str]}"
                @in = { raw_log = "str" }
                @out = { records = "list", errors = "list" }
                @context = """
                Process multi-line string 'raw_log' line by line:
                1. Strip each line. Ignore empty lines and lines starting with '#'.
                2. For every other line, call parse_transaction_line(line).
                3. If it succeeds, append the returned dict to 'records' list.
                4. If it raises ValueError, append the original stripped line to 'errors' list.
                Return {'records': records, 'errors': errors}.
                """
                @invariant = """
                sample = '''
                # Monthly log
                2026-10-01 | INCOME | 3000 | Salary
                bad_line_here
                2026-10-02 | EXPENSE | 100 | Food
                '''
                res = input(raw_log=sample)
                if len(res.get('records', [])) != 2:
                    incomplete(f"Expected 2 valid records, got: {res}")
                if res.get('errors') != ['bad_line_here']:
                    incomplete(f"Expected 1 error 'bad_line_here', got: {res.get('errors')}")
                complete()
                """
            }
        }
    }

    folder analytics {
        file math_engine.py {
            @info = "Tax and anomaly calculation algorithms"

            void calculate_progressive_tax {
                @info = "Calculates progressive tax on net profit: 0% up to 1000, 10% on (1000..5000], 20% above 5000"
                @in = { profit = "float" }
                @out = { tax = "float" }
                @context = """
                Calculate progressive tax for 'profit':
                - If profit <= 1000: tax is 0.0.
                - If 1000 < profit <= 5000: tax is 10% (0.10) of (profit - 1000).
                - If profit > 5000: tax is 400.0 + 20% (0.20) of (profit - 5000).
                Return the tax rounded to 2 decimal places as float.
                """
                @invariant = """
                if input(profit=800.0) != 0.0:
                    incomplete("Profit 800 should have 0.0 tax")
                if input(profit=3000.0) != 200.0:
                    incomplete(f"Profit 3000 should have 200.0 tax, got {input(profit=3000.0)}")
                if input(profit=7000.0) != 800.0:
                    incomplete(f"Profit 7000 should have 800.0 tax, got {input(profit=7000.0)}")
                complete()
                """
            }

            void detect_expense_anomalies {
                @info = "Finds EXPENSE records where amount is strictly greater than 2x the average expense amount, returns list of their categories"
                @in = { records = "list" }
                @out = { anomalies = "list" }
                @context = """
                Given 'records' (a list of transaction dicts with keys 'kind', 'amount', 'category'):
                1. Filter only records where record['kind'] == 'EXPENSE'.
                2. If there are no EXPENSE records, return an empty list [].
                3. Compute the average 'amount' across all EXPENSE records.
                4. Return a list of 'category' strings for all EXPENSE records where record['amount'] > 2.0 * average_expense (preserving order).
                """
                @invariant = """
                recs = [
                    {'kind': 'INCOME', 'amount': 10000.0, 'category': 'Salary'},
                    {'kind': 'EXPENSE', 'amount': 100.0, 'category': 'Food'},
                    {'kind': 'EXPENSE', 'amount': 100.0, 'category': 'Transport'},
                    {'kind': 'EXPENSE', 'amount': 100.0, 'category': 'Coffee'},
                    {'kind': 'EXPENSE', 'amount': 900.0, 'category': 'LuxuryWatch'}
                ]
                # Average expense = 1200 / 4 = 300. 2x average = 600. 900 > 600 -> ['LuxuryWatch']
                ans = input(records=recs)
                if ans != ['LuxuryWatch']:
                    incomplete(f"Expected ['LuxuryWatch'], got {ans}")
                if input(records=[]) != []:
                    incomplete("Empty records must return []")
                complete()
                """
            }
        }

        file aggregator.py {
            @import = ["/fin_engine/analytics/math_engine.py"]

            void build_financial_summary {
                @use = ["calculate_progressive_tax", "detect_expense_anomalies"]
                @info = "Computes full financial metrics dict from transaction records"
                @in = { records = "list" }
                @out = {
                    total_income = "float",
                    total_expense = "float",
                    net_profit = "float",
                    tax = "float",
                    net_after_tax = "float",
                    anomalies = "list"
                }
                @context = """
                Given a list of transaction dicts 'records' (each has 'kind', 'amount', 'category'):
                1. total_income = round(sum of 'amount' for records where kind == 'INCOME', 2).
                2. total_expense = round(sum of 'amount' for records where kind == 'EXPENSE', 2).
                3. net_profit = round(total_income - total_expense, 2).
                4. tax = call calculate_progressive_tax(net_profit).
                5. net_after_tax = round(net_profit - tax, 2).
                6. anomalies = call detect_expense_anomalies(records).
                Return dict with keys: 'total_income', 'total_expense', 'net_profit', 'tax', 'net_after_tax', 'anomalies'.
                """
                @invariant = """
                recs = [
                    {'kind': 'INCOME', 'amount': 5000.0, 'category': 'Salary'},
                    {'kind': 'EXPENSE', 'amount': 1000.0, 'category': 'Rent'}
                ]
                s = input(records=recs)
                if s.get('net_profit') != 4000.0 or s.get('tax') != 300.0 or s.get('net_after_tax') != 3700.0:
                    incomplete(f"Math mismatch in summary: {s}")
                complete()
                """
            }
        }
    }

    folder reporting {
        file pipeline.py {
            @import = [
                "/fin_engine/parsers/log_parser.py",
                "/fin_engine/analytics/aggregator.py"
            ]

            void run_audit_pipeline {
                @use = ["parse_log_batch", "build_financial_summary"]
                @info = "End-to-end financial audit pipeline returning summary, error_count, and report_text"
                @in = { raw_log = "str" }
                @out = {
                    summary = "dict",
                    error_count = "int",
                    report_text = "str"
                }
                @context = """
                Execute the full financial audit pipeline:
                1. Call batch = parse_log_batch(raw_log).
                2. Extract valid records = batch['records'] and error_count = len(batch['errors']).
                3. Call summary = build_financial_summary(records).
                4. Create a single-line report_text formatted EXACTLY as:
                   f"INC:{summary['total_income']}|EXP:{summary['total_expense']}|NET:{summary['net_after_tax']}|ERR:{error_count}"
                5. Return {'summary': summary, 'error_count': error_count, 'report_text': report_text}.
                """
                @checkpoint = true
                @invariant = """
                log_data = '''
                # Audit Log
                2026-10-01 | INCOME | 6000 | Consulting
                2026-10-02 | EXPENSE | 1000 | ServerCosts
                corrupted_line_123
                '''
                res = input(raw_log=log_data)
                if res.get('error_count') != 1:
                    incomplete(f"Expected error_count=1, got {res}")
                if res.get('report_text') != "INC:6000.0|EXP:1000.0|NET:4600.0|ERR:1":
                    incomplete(f"Unexpected report_text: {res.get('report_text')}")
                complete()
                """
            }
        }
    }
}